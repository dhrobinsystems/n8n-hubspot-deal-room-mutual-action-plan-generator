# -----------------------------------------------------------------------------
# n8n-hubspot-deal-room-mutual-action-plan-generator
# Copy to .env (git-ignored) for the Node.js runtime, or set the same variables
# on the n8n host. Every credential below is a dummy placeholder.
# Out of the box nothing is created, written or sent:
#   DRY_RUN=true, SANDBOX_MODE=true, DOC_PROVIDER=stub, CLIENT_NUDGES_ENABLED=false
# -----------------------------------------------------------------------------

# --- Safety switches (anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true

# --- Node.js server
PORT=3000
WEBHOOK_PATH=/webhooks/deal-stage
WEBHOOK_MAX_BODY_BYTES=262144
# Bearer token for POST /monitor/run (24+ characters). Placeholder = endpoint disabled.
ADMIN_API_TOKEN=your_admin_api_token_here

# --- Webhook authentication (HubSpot workflow "Send a webhook" -> header)
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
WEBHOOK_SECRET_HEADER=x-webhook-secret

# --- Trigger: comma-separated internal deal stage IDs that start a MAP
# (find them with GET /crm/v3/pipelines/deals; "presentationscheduled" is a HubSpot default stage)
TRIGGER_STAGE_IDS=presentationscheduled
REGENERATE_EXISTING_MAP=false

# --- Scheduling
# Comma-separated YYYY-MM-DD dates skipped by business-day math (sample US dates: replace with your region's)
HOLIDAYS=2026-11-26,2026-12-24,2026-12-25,2026-12-31,2027-01-01
MIN_RUNWAY_BUSINESS_DAYS=5
# Optional JSON array overriding the default milestone template (see README)
MILESTONE_TEMPLATE_JSON=

# --- MAP document
# stub (no document created) | google_docs | notion
DOC_PROVIDER=stub
SELLER_COMPANY_NAME=Your Company
MAP_INCLUDE_AMOUNT=false
MAP_INCLUDE_CONTACT_EMAILS=false
STUB_DOC_BASE_URL=https://docs.example.com/maps
# Optional JSON overriding internal role labels, e.g. {"se":"Solutions Engineering","deal_desk":"Deal Desk"}
INTERNAL_ROLE_LABELS_JSON=

# Google Docs (service account; share the target folder with its client_email)
GOOGLE_SERVICE_ACCOUNT_JSON=your_google_service_account_json_here
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_SANDBOX_FOLDER_ID=your_google_sandbox_folder_id_here
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file

# Notion (internal integration shared with the database)
NOTION_API_TOKEN=your_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
NOTION_SANDBOX_DATABASE_ID=your_notion_sandbox_database_id_here
NOTION_TITLE_PROPERTY=Name
NOTION_API_VERSION=2022-06-28

# --- HubSpot (Private App). A placeholder token keeps the client offline.
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here
HUBSPOT_SANDBOX_PORTAL_ID=your_hubspot_sandbox_portal_id_here
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_APP_BASE_URL=https://app.hubspot.com

# --- Slack (bot token + channel IDs, or incoming webhooks). Sandbox target required while SANDBOX_MODE=true.
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_SANDBOX_CHANNEL_ID=your_slack_sandbox_channel_id_here
SLACK_SANDBOX_WEBHOOK_URL=your_slack_sandbox_webhook_url_here
# JSON map of HubSpot owner ID -> Slack user ID for @mentions, e.g. {"12345":"U0EXAMPLE1"}
OWNER_SLACK_MAP_JSON={}
ANNOUNCE_NEW_MAPS=true
# Client-facing nudges in the deal's Slack Connect channel (map_slack_connect_channel_id)
CLIENT_NUDGES_ENABLED=false

# --- Weekly monitor
# n8n: edit the cron on the "Weekly Milestone Check" node (default Monday 09:00).
# Node.js: schedule `node src/index.js --monitor` with cron.
NUDGE_COOLDOWN_DAYS=6
DUE_SOON_BUSINESS_DAYS=3
MONITOR_MAX_DEALS=500

# --- Offline simulation only
SIMULATE_TODAY=2026-11-16
